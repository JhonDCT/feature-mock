{
  "name": "feature-mock",
  "version": "1.0.2",
  "description": "CLI mock server with TUI for feature-driven development",
  "type": "module",
  "module": "dist/index.js",
  "main": "dist/index.js",
  "bin": {
    "feature-mock": "dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "start": "node dist/cli.js",
    "dev": "tsx watch bin/cli.ts",
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build"
  },
  "engines": {
    "node": ">=20.12.0"
  },
  "keywords": [
    "mock",
    "feature",
    "tui",
    "cli",
    "acceptance-criteria",
    "mock-server",
    "node"
  ],
  "license": "MIT",
  "dependencies": {
    "@clack/prompts": "^1.6.0"
  },
  "types": "dist/index.d.ts",
  "devDependencies": {
    "@types/node": "^20.19.43",
    "tsup": "^9.0.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  }
}
